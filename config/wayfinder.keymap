#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        bt_clr_macro: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        bt_clr_safe: bt_clr_safe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <1000>;
            bindings = <&bt_clr_macro>, <&none>;
        };

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        bckspace_del: bckspace_del {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------
            // | ESC  |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |     | DE_Z|  U  |  I  |  O  |  P  | ENTF |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  <  | ENT  |
            // | CTRL |DE_Y |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  -  | APOS |
            //              | GUI | ALT | LOW | SPC |     | SPC | LOW | ALT | SHFT|

            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4       &kp N5       &kp N6     &kp N7       &kp N8       &kp N9          &kp N0              &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E     &kp R        &kp T        &kp DE_Z   &kp U        &kp I        &kp O           &kp P               &bckspace_del
&kp LSHFT  &kp A     &kp S     &kp D     &hm LSHFT F  &hm LCTRL G  &kp H      &hm LSHFT J  &hm LCTRL K  &hm LEFT_ALT L  &hm LEFT_GUI DE_LT  &kp RET
&kp LCTRL  &kp DE_Y  &kp X     &kp C     &kp V        &kp B        &kp N      &kp M        &kp COMMA    &kp DOT         &kp DE_MINUS        &kp DE_HASH
                     &kp LGUI  &kp LALT  &mo 1        &kp SPACE    &kp SPACE  &mo 1        &kp RALT     &mo 2
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |          |   &   |   /   |   \   |   *   |   =   | BTCLR |
            // |  TAB  |DE_LPAR|DE_RPAR| UARW  | HOME  |  End  |          |       |   ü   |   ä   |   ö   |   ß   | PG_UP |
            // |  SHFT |       | LARW  | DARW  | RARW  |       |          |DE_LBKT|DE_RBKT|   {   |   }   |   >   | PG_DN |
            // |  CTRL |       |       |       |       |       |          |   |   |   _   |   ?   |   !   |       |       |
            //                 | GUI   | ALT   |       | SPC   |          | SPC   |       |  ALT  |  SHFT |

            bindings = <
&kp DE_GRAVE  &bt BT_SEL 0            &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4       &kp DE_AMPS  &kp DE_FSLH      &kp DE_BSLH      &kp DE_ASTRK     &kp DE_EQUAL  &bt_clr_safe 0 0
&kp TAB       &kp DE_LPAR             &kp DE_RPAR   &kp UP        &kp HOME      &kp END            &none        &kp DE_U_UMLAUT  &kp DE_A_UMLAUT  &kp DE_O_UMLAUT  &kp DE_SZ     &kp PG_UP
&kp LSHFT     &kp LS(LC(LEFT_ARROW))  &kp LEFT      &kp DOWN      &kp RIGHT     &kp LS(LC(RIGHT))  &kp DE_LBKT  &kp DE_RBKT      &kp DE_LBRC      &kp DE_RBRC      &kp DE_GT     &kp PG_DN
&kp LCTRL     &none                   &none         &none         &none         &none              &kp DE_PIPE  &kp DE_UNDER     &kp DE_QMARK     &kp DE_EXCL      &none         &none
                                      &kp LGUI      &kp LALT      &none         &kp SPACE          &kp SPACE    &none            &kp RALT         &kp RSHFT
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
                 &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
