#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <locale/keys_de.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ---------------------------------------------------------------------------------
// | ESC  |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |     |  Z  |  U  |  I  |  O  |  P  | ENTF |
// | SHFT |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  <  | ENT  |
// | CTRL |  Y  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  -  | APOS |
//              | GUI | ALT | LOW | SPC |     | SPC | LOW | ALT | SHFT|
                        bindings = <
   &kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5              &kp N6   &kp N7   &kp N8    &kp N9   &kp N0      &kp BSPC
   &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T               &kp Z    &kp U    &kp I     &kp O    &kp P       &kp DEL
   &kp LSHFT &kp A    &kp S    &kp D    &kp F    &kp G               &kp H    &kp J    &kp K     &kp L    &kp DE_LT   &kp RET
   &kp LCTRL &kp Y    &kp X    &kp C    &kp V    &kp B               &kp N    &kp M    &kp COMMA &kp DOT  &kp DE_MINUS &kp DE_HASH
                      &kp LGUI &kp LALT &mo 1    &kp SPACE           &kp SPACE &mo 1   &kp RALT  &kp RSHFT
                        >;
                };
                lower_layer {
// ------------------------------------------------------------------------------------------------------------
// |   `   |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |          |   &   |   /   |   \   |   *   |   =   | BTCLR |
// |  TAB  |       | UARW  | HOME  |  End  |       |          |       |   ü   |   ä   |   ö   |   ß   | PG_UP |
// |  SHFT | LARW  | DARW  | RARW  |DE_LPAR|DE_RPAR|          |DE_LBKT|DE_RBKT|   {   |   }   |   >   | PG_DN |
// |  CTRL |       |       |       |       |       |          |   |   |   _   |   ?   |   !   |       |       |
//                 | GUI   | ALT   |       | SPC   |          | SPC   |       |  ALT  |  SHFT |
                        bindings = <
     &kp DE_GRAVE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4         &kp DE_AMPS     &kp DE_FSLH     &kp DE_BSLH  &kp DE_ASTRK    &kp DE_EQUAL    &bt BT_CLR
     &kp TAB      &none        &kp UP       &kp HOME     &kp END      &none                &none           &kp DE_U_UMLAUT &kp DE_A_UMLAUT &kp DE_O_UMLAUT &kp DE_SZ       &kp PG_UP
     &kp LSHFT    &kp LEFT     &kp DOWN     &kp RIGHT    &kp DE_LPAR  &kp DE_RPAR          &kp DE_LBKT     &kp DE_RBKT     &kp DE_LBRC  &kp DE_RBRC     &kp DE_GT       &kp PG_DN
     &kp LCTRL    &none        &none        &none        &none        &none                &kp DE_PIPE     &kp DE_UNDER    &none        &none           &none           &none
                               &kp LGUI     &kp LALT     &none        &kp SPACE            &kp SPACE       &none           &kp RALT     &kp RSHFT
                        >;
                };
        };
};
